{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agntn-encodings",
  "account_id": "6ef8d3cbe19975e93d994f25228488e7",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "NUXT_SITE_URL": "https://encodings.agntn.dev"
  },
  "workers_dev": true,
  "preview_urls": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agntn-encodings",
      "database_id": "1d2ba641-03e2-4133-9717-d492b426bda1"
    }
  ],
  "routes": [{ "pattern": "encodings.agntn.dev", "custom_domain": true }],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "previews": {
    "vars": {
      "NUXT_SITE_URL": "https://encodings.agntn.dev"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_id": "ee6e6942-3c77-4366-89ec-96d96526ef40"
      }
    ]
  }
}
